<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz="0.172 0 0.085" rpy="0 0 0"/>  
        <!-- the rplidar c1 has it laser scans emmitted at a height of 29.8mm from the base od the sensor, this was added to the height of the chasis to get 85mm used above -->
    </joint>

    <link name="laser_frame">
        <visual>
            <origin xyz="0 0 -0.017"/>
            <geometry>
                <box size="0.055 0.055 0.023"/>
            </geometry>
            <material name="black"/>
        </visual>
        <visual>
            <origin xyz="0 0 0.003"/>
            <geometry>
                <cylinder radius="0.022" length="0.018"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.022" length="0.018"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.018" radius="0.022">
            <origin xyz="0 0 0.003" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>



    <gazebo reference="laser_frame">
        <material>Gazebo/Black</material>

        <sensor name="laser" type="gpu_lidar">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.05</min>
                    <max>12</max>
                </range>
            </lidar>
                <topic>scan</topic>
                <gz_frame_id>laser_frame</gz_frame_id>
        </sensor>
    </gazebo>

</robot>